# Gemini Interactions API powers typed itinerary conversation and notification agents.
GEMINI_API_KEY=

# Optional Gemini model override.
GEMINI_MODEL=gemini-3.6-flash

# Server-side Google Routes API key. Restrict this key to Routes API only;
# do not use the browser key here because Node requests have no HTTP referrer.
GOOGLE_MAPS_API_KEY=
# Browser-side Google Maps JavaScript API key (restrict by local/prod origins).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_ROUTES_BASE_URL=https://routes.googleapis.com/directions/v2:computeRoutes

# Taiwan city data feeds (server-only).
TDX_BASE_URL=https://tdx.transportdata.tw
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
CWA_API_KEY=
# Optional for a later phase. No disaster-data replacement feed is enabled.
NCDR_API_KEY=

# Optional Taipei Metro member API; TDX still supplies metro service alerts.
# No live crowding fallback is enabled when this is empty.
TAIPEI_METRO_API_KEY=
TAIPEI_METRO_CROWDING_URL=

# SQLite day-itinerary snapshot store.
ROUTECRAFT_DB_PATH=.data/routecraft-local.sqlite
