# Gemini Interactions API powers the Routecraft chat.
GEMINI_API_KEY=

# Optional model override for Google ADK agents.
GEMINI_MODEL=gemini-3.6-flash

# Routes and Places typed tools used by scheduler/review agents.
GOOGLE_MAPS_API_KEY=

# SQLite snapshot store. The default is .data/routecraft.sqlite.
ROUTECRAFT_DB_PATH=.data/routecraft.sqlite
